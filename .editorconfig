root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,html,css,js,md,json,toml,yml,yaml,sh}]
indent_style = space
indent_size = 4

# These three keep Windows line endings (see CLAUDE.md); do not convert them.
[orders/services/engine.py]
end_of_line = crlf

[orders/services/scrapers/{talkroute,merchant_pay}.py]
end_of_line = crlf

# generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# secret path segment for the WebJoint webhook URLs (hooks/<WEBHOOK_SECRET>/new_order ...).
# URL-safe characters only. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# leave unset in normal use; "true" turns on Django debug pages (never on a tunnel)
DJANGO_DEBUG=

# "true" runs Chrome without a window
HEADLESS=

DB_NAME=tgpfflows
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

NGROK_AUTH_TOKEN=

WEEDMAPS_EMAIL=
WEEDMAPS_PASSWORD=

MERCHANT_PAY_EMAIL=
MERCHANT_PAY_PASSWORD=
MERCHANT_PAY_IMAP_USER=
MERCHANT_PAY_IMAP_PASS=

TALKROUTE_EMAIL=
TALKROUTE_PASSWORD=
# a phone that is safe to text while trying things out: manage.py send_test_message --sms
TALKROUTE_TEST_PHONE=
# where the scraper keeps its saved TalkRoute login (see RUNBOOK.md, "TalkRoute login"); leave empty for .browser_profiles/talkroute
TALKROUTE_PROFILE_DIR=

WEBJOINT_EMAIL=
WEBJOINT_PASSWORD=

ANTHROPIC_API_KEY=
# model that reads invoices; leave empty for the built-in default
INVOICE_MODEL=

# Distance Matrix API key for real driving times between cities; leave empty to keep
# using the stored travel-time table (see orders/services/travel.py)
GOOGLE_MAPS_API_KEY=

# bot token from @BotFather; chat_id is the channel's @username (public) or
# numeric chat ID (private, get it via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CELERY_BROKER_URL=redis://localhost:6379/0

# talkroute api access for sending messages
TALKROUTE_API_KEY=
# generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# secret path segment for the WebJoint webhook URLs (hooks/<WEBHOOK_SECRET>/new_order ...).
# URL-safe characters only. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# leave unset in normal use; "true" turns on Django debug pages (never on a tunnel)
DJANGO_DEBUG=

DB_NAME=tgpfflows
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

NGROK_AUTH_TOKEN=

WEEDMAPS_EMAIL=
WEEDMAPS_PASSWORD=

MERCHANT_PAY_EMAIL=
MERCHANT_PAY_PASSWORD=
MERCHANT_PAY_IMAP_USER=
MERCHANT_PAY_IMAP_PASS=

TALKROUTE_EMAIL=
TALKROUTE_PASSWORD=
TALKROUTE_PHONE=
TALKROUTE_TEST_PHONE=

WEBJOINT_EMAIL=
WEBJOINT_PASSWORD=

ANTHROPIC_API_KEY=

# bot token from @BotFather; chat_id is the channel's @username (public) or
# numeric chat ID (private, get it via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CELERY_BROKER_URL=redis://localhost:6379/0
